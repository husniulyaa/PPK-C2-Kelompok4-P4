# Environment Variables Example for Student Expense Tracker

# Neon Cloud PostgreSQL Connection URL
# Replace with your Neon connection string from https://console.neon.tech
# Format: postgresql://[user]:[password]@[endpoint-hostname]/[database-name]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_password_here@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Authentication (minimum 32 characters recommended)
JWT_SECRET="student-expense-tracker-secret-key-super-secure-2026-university-project"

# Node Environment
NODE_ENV="development"
